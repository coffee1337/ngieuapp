<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ScheduleWidgetRowContainer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:background">@drawable/widget_row_background</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">7dp</item>
    </style>
    <style name="ScheduleWidgetRowContainer.Large">
        <item name="android:layout_marginTop">5dp</item>
    </style>
    <style name="ScheduleWidgetTime">
        <item name="android:layout_width">76dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:text">10:40–12:10</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="ScheduleWidgetTime.Large">
        <item name="android:layout_width">84dp</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="ScheduleWidgetSubject">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:text">Основы программирования</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="ScheduleWidgetSubject.Large">
        <item name="android:textSize">13sp</item>
    </style>
    <style name="ScheduleWidgetRoom">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">7dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:text">205</item>
        <item name="android:textColor">#E6FFFFFF</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="ScheduleWidgetRoom.Large">
        <item name="android:textSize">12sp</item>
    </style>
</resources>
